# Doxygen configuration for the Edel toolchain.
# Generates API documentation for the compiler, assembler, processor emulator,
# shared library, and visualiser.
#
# Documentation will be written to:
#   docs/doxygen/html/index.html

# The project name displayed throughout the documentation.
PROJECT_NAME = "Edel Toolchain"

# A short description shown on the documentation home page.
PROJECT_BRIEF = "Compiler, assembler, and processor emulator for the Edel teaching language"

# Directory where all generated documentation is written.
OUTPUT_DIRECTORY = docs/doxygen

# Keep the output in a single directory hierarchy.
CREATE_SUBDIRS = NO

# Directories that Doxygen should scan for source files.
INPUT = shared \
        processor/src \
        assembler/src \
        compiler/src \
        visualiser/src

# Search all subdirectories recursively.
RECURSIVE = YES

# Only process C++ header and source files.
FILE_PATTERNS = *.h *.hpp *.cpp

# Ignore these files when generating documentation.
EXCLUDE = visualiser/src/components/either.cpp \
          visualiser/src/components/either.hpp \
          visualiser/src/components/boolean.cpp \
          visualiser/src/components/boolean.hpp

# Ignore files inside debug build directories.
EXCLUDE_PATTERNS = */cmake-build-debug/*

# Only include documented entities by default.
EXTRACT_ALL = NO

# Include documented private members.
EXTRACT_PRIVATE = YES

# Include documented private virtual functions.
EXTRACT_PRIV_VIRTUAL = YES

# Include documented static members and functions.
EXTRACT_STATIC = YES

# Include classes declared within local scopes.
EXTRACT_LOCAL_CLASSES = YES

# Warn about undocumented classes, functions, and members.
WARN_IF_UNDOCUMENTED = YES

# Warn when documentation is present but incomplete.
WARN_IF_INCOMPLETE_DOC = YES

# Warn when function parameters are missing @param documentation.
WARN_NO_PARAMDOC = YES

# Generate HTML documentation.
GENERATE_HTML = YES

# Do not generate LaTeX documentation.
GENERATE_LATEX = NO

# Enable Graphviz (dot) support to generate diagrams such as inheritance,
# collaboration, include dependency, and call graphs.
HAVE_DOT = YES

# Generate inheritance diagrams for classes.
CLASS_GRAPH = YES

# Generate collaboration diagrams showing class relationships.
COLLABORATION_GRAPH = YES

# Generate include dependency graphs for files.
INCLUDE_GRAPH = YES

# Generate reverse include dependency graphs.
INCLUDED_BY_GRAPH = YES

# Generate call graphs showing which functions are called.
CALL_GRAPH = YES

# Generate caller graphs showing which functions invoke a function.
CALLER_GRAPH = YES

# Generate directory dependency graphs.
DIRECTORY_GRAPH = YES

# Use SVG images for better quality and scalability in HTML output.
DOT_IMAGE_FORMAT = svg

# Produce cleaner diagrams by hiding details from external libraries.
HIDE_UNDOC_RELATIONS = YES